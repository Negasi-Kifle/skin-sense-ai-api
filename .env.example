# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# CORS — comma-separated origins (admin + client Vite dev servers)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Mongo
MONGODB_URI=mongodb://127.0.0.1:27017/skinsense

# Auth
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# AI provider — PRD §7.1, NFR1
# When MOCK_MODE=true, MockSkinAnalysisProvider is used (no network).
# Set MOCK_MODE=false AND provide ANTHROPIC_API_KEY to use Claude Vision.
MOCK_MODE=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Seed defaults (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@kuriftu.local
SEED_ADMIN_PASSWORD=admin1234
SEED_THERAPIST_EMAIL=therapist@kuriftu.local
SEED_THERAPIST_PASSWORD=therapist1234
